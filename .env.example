# Copy this file to .env and fill in your SMTP credentials
# The form will send emails to kinitechno@yahoo.com from this account

# SMTP configuration — defaults shown are for Gmail (recommended)
# For Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# For Yahoo Mail SMTP:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_USER=your-yahoo-email@yahoo.com
# SMTP_PASS=your-yahoo-app-password   # Yahoo also requires an App Password

PORT=3000
